<mxfile host="app.diagrams.net"><diagram id="esan-smartdna" name="Esan SmartDNA Flowchart"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1654" pageHeight="6000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ระบบนำเสนอหลักสูตรการเรียนรู้ Smart City สำหรับหน่วยงานภาครัฐ&lt;br&gt;&lt;font style=&amp;quot;font-size:15px&amp;quot;&gt;ทีม Esan SmartDNA&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="60" as="geometry"/></mxCell><mxCell id="lane_L" value="ผู้เรียน (บุคลากรภาครัฐ)" style="swimlane;startSize=40;fillColor=#F6F9FF;strokeColor=#D5DAE1;fontSize=15;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="600" height="5470" as="geometry"/></mxCell><mxCell id="lane_S" value="ระบบ Esan SmartDNA" style="swimlane;startSize=40;fillColor=#F7F3FF;strokeColor=#D5DAE1;fontSize=15;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="600" height="5470" as="geometry"/></mxCell><mxCell id="lane_A" value="ผู้ดูแลหลักสูตร (Admin)" style="swimlane;startSize=40;fillColor=#FFF7F2;strokeColor=#D5DAE1;fontSize=15;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1200" y="70" width="600" height="5470" as="geometry"/></mxCell><mxCell id="start" value="เริ่มต้น" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;fontSize=14;fontStyle=1;" vertex="1" parent="lane_L"><mxGeometry x="230" y="88" width="140" height="44" as="geometry"/></mxCell><mxCell id="lp" value="&lt;b&gt;OUTPUT:&lt;/b&gt; หน้า Landing Page&lt;br&gt;(About Team, Course, Innovation, Contact)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#58D68D;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><m