;fillColor=#D6EAF8;strokeColor=#5DADE2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_L"><mxGeometry x="175" y="578" width="250" height="64" as="geometry"/></mxCell><mxCell id="cv" value="ตรวจสอบความครบถ้วน&lt;br&gt;และรูปแบบอีเมล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="185" y="680" width="230" height="60" as="geometry"/></mxCell><mxCell id="cd" value="ข้อมูลครบ&lt;br&gt;และถูกต้อง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="190" y="768" width="220" height="84" as="geometry"/></mxCell><mxCell id="cs" value="บันทึกข้อความ และส่งอีเมล&lt;br&gt;แจ้งเตือนไปยังอีเมลทีม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="185" y="880" width="230" height="60" as="geometry"/></mxCell><mxCell id="co" value="&lt;b&gt;OUTPUT:&lt;/b&gt; แจ้งส่งสำเร็จ +&lt;br&gt;อีเมลตอบรับอัตโนมัติ" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#58D68D;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="175" y="978" width="250" height="64" as="geometry"/></mxCell><mxCell id="ca" value="ทีมงานตอบกลับผู้ติดต่อ&lt;br&gt;ภายใน 2 วันทำการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_A"><mxGeometry x="185" y="1080" width="230" height="60" as="geometry"/></mxCell><mxCell id="dmore" value="ต้องการดู&lt;br&gt;เมนูอื่นต่อ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="190" y="1168" width="220" height="84" as="geometry"/></mxCell><mxCell id="dreg" value="ต้องการสมัครเรียน /&lt;br&gt;