"geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;OUTPUT:&lt;/b&gt; อีเมลยืนยัน&lt;br&gt;การเปิดบัญชี" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#58D68D;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_A"><mxGeometry x="29" y="1878" width="250" height="64" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;OUTPUT:&lt;/b&gt; แจ้งเหตุผลการปฏิเสธ&lt;br&gt;และช่องทางติดต่อ" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#58D68D;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_A"><mxGeometry x="321" y="1878" width="250" height="64" as="geometry"/></mxCell><mxCell id="end1" value="สิ้นสุด" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;fontSize=14;fontStyle=1;" vertex="1" parent="lane_A"><mxGeometry x="376" y="1988" width="140" height="44" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;INPUT:&lt;/b&gt; ชื่อผู้ใช้ และรหัสผ่าน&lt;br&gt;(หรือยืนยันผ่าน ThaiD)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#5DADE2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_L"><mxGeometry x="175" y="2078" width="250" height="64" as="geometry"/></mxCell><mxCell id="p2" value="ตรวจสอบสิทธิ์การเข้าใช้งาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="185" y="2180" width="230" height="60" as="geometry"/></mxCell><mxCell id="d3" value="ล้มเหลวครบ&lt;br&gt;3 ครั้ง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="190" y="2268" width="220" height="84" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;OUTPUT:&lt;/b&gt; ล็อกบัญชี 15 นาที&lt;br&gt;และแจ้งเตือนทางอีเมล" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#58D68D;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="330" y="2378" width="250" height="64" as="geometry"/></mxCell><mxCell id="end2" value="สิ้นสุด" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontColor=#1B1F24;fontSize=14;fontStyle=1;" vertex="1" parent="lane_S"><mxGeometry x="385" y="2488" width="140" height="44" as="geometry"/></mxCell><mxCell id="d4" value="เข้าสู่ระบบ&lt;br&gt;สำเร็จ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="135" y="2468" width="220" height="84" as="geometry"/></mxCell><mxCell id="p3" value="ดึงข้อมูลโปรไฟล์ผู้เรียน&lt;br&gt;(หน่วยงาน, ตำแหน่ง, ประวัติ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="130" y="2580" width="230" height="60" as="geometry"/></mxCell><mxCell id="d5" value="เคยทำแบบประเมิน&lt;br&gt;ความพร้อมแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_S"><mxGeometry x="135" y="2668" width="220" height="84" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;INPUT:&lt;/b&gt; แบบประเมินความพร้อม (Pre-test)&lt;br&gt;ทักษะดิจิทัล + ความสนใจ Smart City 7 ด้าน" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#5DADE2;fontColor=#1B1F24;fontSize=13;" vertex="1" parent="lane_L"><mxGeometry x="175" y="2778" width="250" height="64" as="geometry"/></mxCell><mxCell id="p4" value="บันทึกผลการประเมิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=13;" vertex="1"